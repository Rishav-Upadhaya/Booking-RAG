# Database
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5433/rag

# Redis
REDIS_URL=redis://localhost:6380/0

# Pinecone (vector store + hosted sparse/rerank models via the inference API)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=documents
PINECONE_REGION=us-east-1

# Embeddings: "auto" (default) uses Jina cloud embeddings when JINA_API_KEY is set,
# otherwise it downloads/uses the local sentence-transformers model.
# Use EMBEDDER_PROVIDER=local to force the local model, or EMBEDDER_PROVIDER=jina to require the cloud key.
EMBEDDER_PROVIDER=auto
JINA_API_KEY=
JINA_MODEL=jina-embeddings-v3
EMBEDDER_MODEL=all-MiniLM-L6-v2

# OpenRouter LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Retrieval
TOP_K=5
RETRIEVAL_CANDIDATES=20

# Intent classifier
INTENT_DOMAIN_THRESHOLD=0.15

# Ingestion
MAX_UPLOAD_BYTES=52428800
EMBED_BATCH_SIZE=64